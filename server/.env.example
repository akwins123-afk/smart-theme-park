PORT=5000
NODE_ENV=development

# MySQL Root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_theme_park
DB_ROOT_USER=root
DB_ROOT_PASSWORD=your_mysql_root_password

# MySQL RBAC Users
DB_ADMIN_USER=park_admin
DB_ADMIN_PASSWORD=AdminPass@2026

DB_CUSTOMER_USER=park_customer
DB_CUSTOMER_PASSWORD=CustomerPass@2026

# Admin Security Gate (bcrypt hash of 'ThemePark@2026')
ADMIN_PASSWORD_HASH=$2a$10$Py1zsW0kRDXJxTtbA7P6Kelh5UI.AxsAb9nh6q1AWf9gVkmaLTmB.

# JWT Secrets
JWT_ADMIN_SECRET=smart_theme_park_super_secret_admin_jwt_key_2026
JWT_CUSTOMER_SECRET=smart_theme_park_super_secret_customer_jwt_key_2026
